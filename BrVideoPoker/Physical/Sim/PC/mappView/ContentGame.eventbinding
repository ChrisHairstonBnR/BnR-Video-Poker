<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="ContentGame_eventbinding" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="ContentGame.Image_Card1.Click">
      <Source xsi:type="widgets.brease.Image.Event" contentRefId="ContentGame" widgetRefId="Image_Card1" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gCurrentPlayer.HoldArr[0]">
            <Method xsi:type="opcUa.NodeAction.ToggleValueBool" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Image_Card2.Click">
      <Source xsi:type="widgets.brease.Image.Event" contentRefId="ContentGame" widgetRefId="Image_Card2" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gCurrentPlayer.HoldArr[1]">
            <Method xsi:type="opcUa.NodeAction.ToggleValueBool" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Image_Card3.Click">
      <Source xsi:type="widgets.brease.Image.Event" contentRefId="ContentGame" widgetRefId="Image_Card3" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gCurrentPlayer.HoldArr[2]">
            <Method xsi:type="opcUa.NodeAction.ToggleValueBool" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Image_Card4.Click">
      <Source xsi:type="widgets.brease.Image.Event" contentRefId="ContentGame" widgetRefId="Image_Card4" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gCurrentPlayer.HoldArr[3]">
            <Method xsi:type="opcUa.NodeAction.ToggleValueBool" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Image_Card5.Click">
      <Source xsi:type="widgets.brease.Image.Event" contentRefId="ContentGame" widgetRefId="Image_Card5" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::AsGlobalPV:gCurrentPlayer.HoldArr[4]">
            <Method xsi:type="opcUa.NodeAction.ToggleValueBool" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Button_IncreaseBet.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="ContentGame" widgetRefId="Button_IncreaseBet" event="Click" />
      <Operand datatype="ANY_INT" name="BetIndex">
        <ReadTarget xsi:type="opcUa.NodeAction.Read" refId="::VisCtrl:BetIndex">
          <Method xsi:type="opcUa.NodeAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="BetIndex &lt; 5">
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::VisCtrl:BetIndex">
            <Method xsi:type="opcUa.NodeAction.AddValue" value="1" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="ContentGame.Button_DecreaseBet.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="ContentGame" widgetRefId="Button_DecreaseBet" event="Click" />
      <Operand datatype="ANY_INT" name="BetIndex">
        <ReadTarget xsi:type="opcUa.NodeAction.Read" refId="::VisCtrl:BetIndex">
          <Method xsi:type="opcUa.NodeAction.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="BetIndex &gt; 0">
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::VisCtrl:BetIndex">
            <Method xsi:type="opcUa.NodeAction.AddValue" value="-1" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>