<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<OpcUaSource FileVersion="8" ArVersion="D4.92">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <DefaultView>
    <Module Name="&lt;Default&gt;">
      <GlobalVariables Name="Global Variables">
        <Variable Name="gCurrentGame" />
        <Variable Name="gPlayer">
          <Variable Name="Balance" />
          <Variable Name="Hand" EnableArrayElements="True" />
          <Variable Name="HoldArr" EnableArrayElements="True" />
          <Variable Name="ChosenBet" />
          <Variable Name="Winnings" />
        </Variable>
        <Variable Name="gCommand">
          <Variable Name="CMD_Action" />
        </Variable>
      </GlobalVariables>
      <Task Name="GameCode" />
      <Task Name="UserSys">
        <Variable Name="CurrentUser" />
      </Task>
      <Task Name="VisCtrl">
        <Variable Name="BetIndex" />
        <Variable Name="CardStr" EnableArrayElements="True" />
      </Task>
    </Module>
  </DefaultView>
</OpcUaSource>