<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<OpcUaSource FileVersion="8" ArVersion="D4.92">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <DefaultView>
    <Module Name="&lt;Default&gt;">
      <Task Name="GameCode">
        <Variable Name="Player">
          <Variable Name="Balance" />
          <Variable Name="Hand" EnableArrayElements="True" />
          <Variable Name="HoldArr" EnableArrayElements="True" />
        </Variable>
      </Task>
      <Task Name="UserSys">
        <Variable Name="CurrentUser" />
        <Variable Name="MpUserXManagerUI_Connect" AutomaticEnable="True" />
        <Variable Name="MpUserXManagerUI_FB" AutomaticEnable="True" />
        <Variable Name="MpUserXManagerUI_Setup" AutomaticEnable="True" />
      </Task>
    </Module>
  </DefaultView>
</OpcUaSource>