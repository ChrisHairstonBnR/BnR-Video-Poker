<?xml version="1.0" encoding="utf-8"?>
<EventBindingSet id="ContentCreateUser_eventbinding" xmlns="http://www.br-automation.com/iat2014/eventbinding/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Bindings>
    <EventBinding id="ContentCreateUser.Button_Confirm.Click">
      <Source xsi:type="widgets.brease.Button.Event" contentRefId="ContentCreateUser" widgetRefId="Button_Confirm" event="Click" />
      <EventHandler>
        <Action>
          <Target xsi:type="opcUa.NodeAction" refId="::UserSys:CMD_CreateUser">
            <Method xsi:type="opcUa.NodeAction.SetValueBool" value="true" />
          </Target>
        </Action>
      </EventHandler>
    </EventBinding>
    <EventBinding id="EventBinding_5">
      <Source xsi:type="opcUa.Event" refId="::UserSys:CMD_UserCreationDone" event="ValueChanged" />
      <Operand datatype="ANY_STRING" name="user">
        <ReadTarget xsi:type="widgets.brease.TextInput.ReadAction" contentRefId="ContentCreateUser" widgetRefId="TextInput_Username">
          <Method xsi:type="widgets.brease.TextInput.Action.GetValue" />
        </ReadTarget>
      </Operand>
      <Operand datatype="ANY_STRING" name="pass">
        <ReadTarget xsi:type="widgets.brease.Password.ReadAction" contentRefId="ContentCreateUser" widgetRefId="Password1">
          <Method xsi:type="widgets.brease.Password.Action.GetValue" />
        </ReadTarget>
      </Operand>
      <EventHandler condition="newValue = TRUE">
        <Sequence>
          <Step order="0">
            <Action>
              <Target xsi:type="widgets.brease.TextInput.Action" contentRefId="ContentCreateUser" widgetRefId="TextInput_Username">
                <Method xsi:type="widgets.brease.TextInput.Action.SetValue" value="" />
              </Target>
            </Action>
          </Step>
          <Step order="1">
            <Action>
              <Target xsi:type="widgets.brease.Password.Action" contentRefId="ContentCreateUser" widgetRefId="Password1">
                <Method xsi:type="widgets.brease.Password.Action.SetValue" value="" />
              </Target>
            </Action>
          </Step>
          <Step order="4">
            <Action>
              <Target xsi:type="clientSystem.Action">
                <Method xsi:type="clientSystem.Action.CloseDialog" dialogId="DialogCreateUser" />
              </Target>
            </Action>
          </Step>
          <Step order="5">
            <Action>
              <Target xsi:type="opcUa.NodeAction" refId="::UserSys:CMD_UserCreationDone">
                <Method xsi:type="opcUa.NodeAction.SetValueBool" value="false" />
              </Target>
            </Action>
          </Step>
        </Sequence>
      </EventHandler>
    </EventBinding>
  </Bindings>
</EventBindingSet>