  <Navigations />
  <BindingsSets>
    <BindingsSet refId="ContentGame_binding" />
    <BindingsSet refId="ContentResult_binding" />
    <BindingsSet refId="ContentTop_binding" />
    <BindingsSet refId="ContentCreateUser_binding" />
    <BindingsSet refId="ContentTop169_binding" />
  </BindingsSets>
  <EventBindingsSets>
