<?xml version="1.0" encoding="utf-8"?>
<?AutomationStudio FileVersion="4.9"?>
<OpcUaSource FileVersion="8" ArVersion="E4.92">
  <Aliases>
    <ACLAliases />
    <EURangeViolationAliases />
    <EURangesAliases />
    <EngineeringUnitAliases />
  </Aliases>
  <DefaultView>
    <Module Name="&lt;Default&gt;">
      <GlobalVariables Name="Global Variables">
        <Variable Name="gCurrentGame" />
        <Variable Name="gPlayer" AutomaticEnable="True">
          <Variable Name="Balance" />
          <Variable Name="Hand" EnableArrayElements="True" />
          <Variable Name="HoldArr" EnableArrayElements="True" />
          <Variable Name="ChosenBet" />
          <Variable Name="Winnings" />
          <Variable Name="Result" />
          <Variable Name="LoggedIn" />
        </Variable>
        <Variable Name="gCommand" AutomaticEnable="True">
          <Variable Name="CMD_Action" />
        </Variable>
        <Variable Name="gPayTable" AutomaticEnable="True">
          <Variable Name="WinningsScalarArr" EnableArrayElements="True" />
        </Variable>
      </GlobalVariables>
      <Task Name="GameCode">
        <Variable Name="GameState" />
        <Variable Name="ActionButtonStr" />
      </Task>
      <Task Name="UserSys">
        <Variable Name="CurrentUser" />
        <Variable Name="CreateUserNameStr" />
        <Variable Name="CreateUserPassStr" />
        <Variable Name="CMD_CreateUser" />
        <Variable Name="ErrorStr" />
        <Variable Name="CMD_UserCreationDone" />
      </Task>
      <Task Name="VisCtrl">
        <Variable Name="BetIndex" />
        <Variable Name="CardStr" EnableArrayElements="True" />
        <Variable Name="EnableBetting" />
        <Variable Name="ResultStr" />
        <Variable Name="GameStr" />
        <Variable Name="NotLoggedIn" />
        <Variable Name="PayTableStr" EnableArrayElements="True" />
        <Variable Name="PayTableVisible" EnableArrayElements="True" />
        <Variable Name="PayTableScaledWinnings" EnableArrayElements="True" />
      </Task>
    </Module>
  </DefaultView>
</OpcUaSource>