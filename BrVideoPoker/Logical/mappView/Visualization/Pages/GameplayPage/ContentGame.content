<?xml version="1.0" encoding="utf-8"?>
<Content id="ContentGame" height="400" width="800" xmlns="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Widgets>
    <Widget xsi:type="widgets.brease.Image" id="Image_Card1" top="30" left="10" width="140" height="220" zIndex="0" image="Media/Cards/Minicard_Back.svg" useSVGStyling="false" />
    <Widget xsi:type="widgets.brease.Button" id="Button_Action" top="300" left="330" width="150" height="60" zIndex="1" text="Action" textAlign="center" fontSize="18px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Hold1" top="260" left="30" width="100" zIndex="2" text="HOLD" textColor="rgba(255, 255, 255, 1)" fontSize="28px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Hold2" top="260" left="190" width="100" zIndex="3" text="HOLD" textColor="rgba(255, 255, 255, 1)" fontSize="28px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Hold3" top="260" left="350" width="100" zIndex="4" text="HOLD" textColor="rgba(255, 255, 255, 1)" fontSize="28px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Hold4" top="260" left="510" width="100" zIndex="5" text="HOLD" textColor="rgba(255, 255, 255, 1)" fontSize="28px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Hold5" top="260" left="670" width="100" zIndex="6" text="HOLD" textColor="rgba(255, 255, 255, 1)" fontSize="28px" bold="true" visible="false" />
    <Widget xsi:type="widgets.brease.Image" id="Image_Card2" top="30" left="170" width="140" height="220" zIndex="7" image="Media/Cards/Minicard_Back.svg" useSVGStyling="false" />
    <Widget xsi:type="widgets.brease.Image" id="Image_Card3" top="30" left="330" width="140" height="220" zIndex="8" image="Media/Cards/Minicard_Back.svg" useSVGStyling="false" />
    <Widget xsi:type="widgets.brease.Image" id="Image_Card4" top="30" left="490" width="140" height="220" zIndex="9" image="Media/Cards/Minicard_Back.svg" useSVGStyling="false" />
    <Widget xsi:type="widgets.brease.Image" id="Image_Card5" top="30" left="650" width="140" height="220" zIndex="10" image="Media/Cards/Minicard_Back.svg" useSVGStyling="false" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Balance" top="370" left="0" zIndex="11" text="Balance:" textColor="rgba(255, 255, 0, 1)" fontName="Arial" bold="true" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="NumericOutput_Balance" top="370" left="70" width="150" zIndex="12" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1},'imperial':{'decimalPlaces':1,'minimumIntegerDigits':1},'imperial-us':{'decimalPlaces':1,'minimumIntegerDigits':1}}" borderWidth="0px" backColor="rgba(255, 255, 255, 0)" textColor="rgba(255, 255, 0, 1)" textAlign="left" fontSize="14px" padding="0px 5px 0px 5px" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Win" top="370" left="330" width="50" zIndex="13" text="Win:" textColor="rgba(255, 255, 0, 1)" fontName="Arial" bold="true" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="NumericOutput_Win" top="370" left="370" width="150" zIndex="14" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1},'imperial':{'decimalPlaces':1,'minimumIntegerDigits':1},'imperial-us':{'decimalPlaces':1,'minimumIntegerDigits':1}}" borderWidth="0px" backColor="rgba(255, 255, 255, 0)" textColor="rgba(255, 255, 0, 1)" textAlign="left" fontSize="14px" padding="0px 5px 0px 5px" />
    <Widget xsi:type="widgets.brease.Label" id="Label_Bet" top="370" left="650" width="50" zIndex="15" text="Bet:" textColor="rgba(255, 255, 0, 1)" fontName="Arial" bold="true" />
    <Widget xsi:type="widgets.brease.NumericOutput" id="NumericOutput_Bet" top="370" left="700" zIndex="16" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1},'imperial':{'decimalPlaces':1,'minimumIntegerDigits':1},'imperial-us':{'decimalPlaces':1,'minimumIntegerDigits':1}}" borderWidth="0px" backColor="rgba(255, 255, 255, 0)" textColor="rgba(255, 255, 0, 1)" textAlign="left" fontSize="14px" padding="0px 5px 0px 5px" />
    <Widget xsi:type="widgets.brease.FlyOut" id="FlyOut_Bet" top="290" left="0" width="200" height="75" zIndex="17" autoClose="true" buttonOffset="20" docking="right" image="Media/Casino_Chip.svg" imageHeight="50" imageWidth="50" imageColor="rgba(255, 255, 255, 1)" buttonBackColor="rgba(255, 255, 255, 0)" backColor="rgba(128, 128, 255, 1)">
      <Widgets>
        <Widget xsi:type="widgets.brease.NumericOutput" id="NumericOutput_BetChoice" top="20" left="50" zIndex="0" format="{'metric':{'decimalPlaces':2,'minimumIntegerDigits':1},'imperial':{'decimalPlaces':1,'minimumIntegerDigits':1},'imperial-us':{'decimalPlaces':1,'minimumIntegerDigits':1}}" textAlign="center" />
        <Widget xsi:type="widgets.brease.Button" id="Button_IncreaseBet" top="20" left="150" width="30" zIndex="1" text="+" borderWidth="2px" cornerRadius="5px" fontSize="24px" bold="true" padding="0px 0px" />
        <Widget xsi:type="widgets.brease.Button" id="Button_DecreaseBet" top="20" left="20" width="30" zIndex="2" text="-" cornerRadius="5px" fontSize="24px" bold="true" padding="0px 0px" />
      </Widgets>
    </Widget>
    <Widget xsi:type="widgets.brease.Label" id="Label_NotLoggedIn" top="300" left="230" width="340" zIndex="18" text="Log In To Play" textColor="rgba(255, 255, 255, 1)" textAlign="center" fontSize="26px" bold="true" />
  </Widgets>
</Content>