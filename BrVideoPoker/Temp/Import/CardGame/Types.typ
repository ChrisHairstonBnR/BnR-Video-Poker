		(
		CARD_ACE,
		CARD_TWO,
		CARD_THREE,
		CARD_FOUR,
		CARD_FIVE,
		CARD_SIX,
		CARD_SEVEN,
		CARD_EIGHT,
		CARD_NINE,
		CARD_TEN,
		CARD_JACK,
		CARD_QUEEN,
		CARD_KING
		);
	Suits_enum : 
		(
		SUIT_HEARTS,
		SUIT_CLUBS,
		SUIT_DIAMONDS,
		SUIT_SPADES
		);
	Card_typ : 	STRUCT 
